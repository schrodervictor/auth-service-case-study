{
  "name": "case-study-architecture",
  "version": "1.0.0",
  "description": "Architecture for case study",
  "main": "index.js",
  "repository": "git@github.com:hallomarta/case-study-architecture.git",
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "dev": "tsx watch src/index.ts",
    "build": "rimraf ./dist && tsc",
    "start": "node ./dist/index.js",
    "test": "jest -c ./jest.config.json --testPathPatterns='tests/(unit|integration)'",
    "test:unit": "jest -c ./jest.config.json --testPathPatterns=tests/unit",
    "test:integration": "jest -c ./jest.config.json --testPathPatterns=tests/integration --runInBand",
    "test:watch": "jest -c ./jest.config.json --watchAll=true",
    "test:cov": "jest -c ./jest.config.json --coverage",
    "typecheck": "tsc --noEmit",
    "typeorm": "tsx node_modules/typeorm/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^25.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.0.1",
    "eslint-plugin-jest": "^29.15.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.33.0"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.995.0",
    "body-parser": "^1.20.3",
    "express": "^4.22.1",
    "inversify": "^6.2.2",
    "inversify-express-utils": "^6.5.0",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "js-yaml": "^4.1.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@marta/eventbus": "git+ssh://git@github.com:hallomarta/eventbus.git#develop",
    "@marta/release-scripts": "git+ssh://git@github.com:hallomarta/release-scripts.git#master"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
