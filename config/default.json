{
    "server": {
        "port": 9000
    },
    "database": {
        "host": "postgres",
        "port": 5432,
        "name": "case_study_db"
    },
    "auth": {
        "accessToken": {
            "expiresIn": "15m"
        },
        "refreshToken": {
            "expiresIn": "7d"
        }
    },
    "redis": {
        "host": "redis",
        "port": 6379
    },
    "rateLimit": {
        "login": {
            "maxAttempts": 5,
            "windowSeconds": 900
        },
        "refresh": {
            "maxAttempts": 10,
            "windowSeconds": 900
        }
    }
}
