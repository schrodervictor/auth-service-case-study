{
    "server": {
        "port": 9001
    },
    "database": {
        "host": "localhost",
        "port": 5433,
        "name": "case_study_test_db"
    },
    "auth": {
        "accessToken": {
            "expiresIn": "15m"
        },
        "refreshToken": {
            "expiresIn": "7d"
        }
    },
    "redis": {
        "host": "localhost",
        "port": 6379
    },
    "rateLimit": {
        "login": {
            "maxAttempts": 5,
            "windowSeconds": 900
        },
        "refresh": {
            "maxAttempts": 10,
            "windowSeconds": 900
        }
    },
    "eventbus": {
        "mode": "emulated"
    }
}
